@page "/history"
@using FatumApp.Maui.Helps
@using FatumCommon.Domain
@using FatumCommon.Enums
@using FatumApp.Maui.Infrastructure.Data
@using FatumApp.Maui.Services
@using FatumCommon.Infrastructure.Data
@using Microsoft.Maui.ApplicationModel
@inject IUnitOfWork UnitOfWork
@inject NavigationManager Navigation
@inject ILogger<HistoryPage> Logger
@inject IExportService ExportService
@inject ILocalizationService L

<PageTitle>@L.GetString("History.Title") - Fatum</PageTitle>

<div class="container p-3">
    <h1 class="mb-3">@L.GetString("History.Title")</h1>
    <div class="d-flex gap-2 flex-wrap mb-3">
        <button class="btn btn-outline-secondary" @onclick="ExportJsonAsync">@L.GetString("History.ExportJson")</button>
        <button class="btn btn-outline-secondary" @onclick="ExportCsvAsync">@L.GetString("History.ExportCsv")</button>
        <button class="btn btn-outline-primary" @onclick="ImportJsonAsync" disabled="@(_importing)">
            @if (_importing) { <span class="spinner-border spinner-border-sm"></span> }
            @L.GetString("History.ImportJson")
        </button>
        <button class="btn btn-outline-danger" @onclick="DeleteAllAsync" disabled="@(_deletingAll)">@L.GetString("History.DeleteAll")</button>
    </div>

    @if (_successMessage != null)
    {
        <div class="alert alert-success">@_successMessage</div>
    }
    @if (_error != null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (_fatums == null)
    {
        <p>@L.GetString("History.Loading")</p>
    }
    else if (!_fatums.Any())
    {
        <p class="text-muted">@L.GetString("History.NoItems")</p>
    }
    else
    {
        <div class="list-group">
            @foreach (var fatum in _fatums.OrderByDescending(f => f.CreatedAt))
            {
                var anomalias = _anomaliasByFatum.GetValueOrDefault(fatum.Id) ?? new List<Anomalia>();
                <div class="list-group-item">
                    <div class="d-flex w-100 justify-content-between align-items-start">
                        <div>
                            <h6 class="mb-1">Fatum #@fatum.Id</h6>
                            <p class="mb-1 small text-muted">
                                @fatum.CreatedAt.ToLocalTime().ToString("g") · Radio @((fatum.Radio/1000.0).ToString("F1")) km · @fatum.NumPuntos puntos
                            </p>
                            <p class="mb-1 small">Centro: @fatum.Latitude.ToString("F4"), @fatum.Longitude.ToString("F4")</p>

                            <div class="mt-2 small">
                                <div class="d-flex gap-2 align-items-center mb-1">
                                    <span class="text-muted">OLC:</span> <code>@(fatum.OpenLocationCode ?? "—")</code>
                                    <button class="btn btn-sm btn-outline-secondary" title="Copiar OLC" disabled="@string.IsNullOrWhiteSpace(fatum.OpenLocationCode)" @onclick="@(() => CopyCodeAsync(fatum.OpenLocationCode))">📋</button>
                                    <button class="btn btn-sm btn-outline-primary" title="Abrir OLC" disabled="@string.IsNullOrWhiteSpace(fatum.OpenLocationCode)" @onclick="@(() => UrlHelps.OpenPlusCodeAsync(fatum.OpenLocationCode))">↗</button>
                                </div>
                                <div class="d-flex gap-2 align-items-center mb-1">
                                    <span class="text-muted">Geohash:</span> <code>@(fatum.GeoHash ?? "—")</code>
                                    <button class="btn btn-sm btn-outline-secondary" title="Copiar Geohash" disabled="@string.IsNullOrWhiteSpace(fatum.GeoHash)" @onclick="@(() => CopyCodeAsync(fatum.GeoHash))">📋</button>
                                    <button class="btn btn-sm btn-outline-primary" title="Abrir Geohash" disabled="@string.IsNullOrWhiteSpace(fatum.GeoHash)" @onclick="@(() => UrlHelps.OpenGeoHashAsync(fatum.GeoHash))">↗</button>
                                </div>
                                <div class="d-flex gap-2 align-items-center">
                                    <span class="text-muted">what3words:</span> <code>@(fatum.What3Words ?? "—")</code>
                                    <button class="btn btn-sm btn-outline-secondary" title="Copiar what3words" disabled="@string.IsNullOrWhiteSpace(fatum.What3Words)" @onclick="@(() => CopyCodeAsync(fatum.What3Words))">📋</button>
                                    <button class="btn btn-sm btn-outline-primary" title="Abrir what3words" disabled="@string.IsNullOrWhiteSpace(fatum.What3Words)" @onclick="@(() => UrlHelps.OpenWhat3WordsAsync(fatum.What3Words))">↗</button>
                                </div>
                            </div>
                        </div>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-secondary" @onclick="@(() => ViewOnMap(fatum))" title="@L.GetString("History.ViewOnMap")">🗺️</button>
                            <button type="button" class="btn btn-outline-info" @onclick="@(() => OpenHeatmap(fatum.Id))" title="@L.GetString("History.Heatmap")">🔥</button>
                            <button class="btn btn-outline-danger" @onclick="@(() => ConfirmAndDeleteFatumAsync(fatum))" title="@L.GetString("History.Delete")">@L.GetString("History.Delete")</button>
                        </div>
                    </div>
                    @if (anomalias.Any())
                    {
                        <ul class="list-unstyled mt-2 ms-2 small">
                            @foreach (var a in anomalias)
                            {
                                <li>
                                    <div>
                                        <strong>@a.TipoAnomalia</strong> · Power @a.Power.ToString("F1") · Z @a.ZScoreFinal.ToString("F2") ·
                                        <a href="#" @onclick="@(() => ViewAnomaliaOnMap(a))" @onclick:preventDefault>@L.GetString("History.ViewOnMap")</a>
                                    </div>
                                    <div class="mt-1 small">
                                        <div class="d-flex gap-2 align-items-center mb-1">
                                            <span class="text-muted">OLC:</span> <code>@(a.OpenLocationCode ?? "—")</code>
                                            <button class="btn btn-sm btn-outline-secondary" title="Copiar OLC" disabled="@string.IsNullOrWhiteSpace(a.OpenLocationCode)" @onclick="@(() => CopyCodeAsync(a.OpenLocationCode))">📋</button>
                                            <button class="btn btn-sm btn-outline-primary" title="Abrir OLC" disabled="@string.IsNullOrWhiteSpace(a.OpenLocationCode)" @onclick="@(() => UrlHelps.OpenPlusCodeAsync(a.OpenLocationCode))">↗</button>
                                        </div>
                                        <div class="d-flex gap-2 align-items-center mb-1">
                                            <span class="text-muted">Geohash:</span> <code>@(a.GeoHash ?? "—")</code>
                                            <button class="btn btn-sm btn-outline-secondary" title="Copiar Geohash" disabled="@string.IsNullOrWhiteSpace(a.GeoHash)" @onclick="@(() => CopyCodeAsync(a.GeoHash))">📋</button>
                                            <button class="btn btn-sm btn-outline-primary" title="Abrir Geohash" disabled="@string.IsNullOrWhiteSpace(a.GeoHash)" @onclick="@(() => UrlHelps.OpenGeoHashAsync(a.GeoHash))">↗</button>
                                        </div>
                                        <div class="d-flex gap-2 align-items-center">
                                            <span class="text-muted">what3words:</span> <code>@(a.What3Words ?? "—")</code>
                                            <button class="btn btn-sm btn-outline-secondary" title="Copiar what3words" disabled="@string.IsNullOrWhiteSpace(a.What3Words)" @onclick="@(() => CopyCodeAsync(a.What3Words))">📋</button>
                                            <button class="btn btn-sm btn-outline-primary" title="Abrir what3words" disabled="@string.IsNullOrWhiteSpace(a.What3Words)" @onclick="@(() => UrlHelps.OpenWhat3WordsAsync(a.What3Words))">↗</button>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Fatum>? _fatums;
    private Dictionary<long, List<Anomalia>> _anomaliasByFatum = new();
    private string? _error;
    private string? _successMessage;
    private System.Threading.CancellationTokenSource? _copyMessageCts;
    private bool _importing;
    private bool _deletingAll;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync().ConfigureAwait(true);
    }

    private async Task ExportJsonAsync()
    {
        try
        {
            var json = await ExportService.ExportAsJsonAsync().ConfigureAwait(true);
            await ExportService.ShareExportAsync("fatum_export.json", json, "Exportar Fatum (JSON)").ConfigureAwait(true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private async Task ExportCsvAsync()
    {
        try
        {
            var csv = await ExportService.ExportAsCsvAsync().ConfigureAwait(true);
            await ExportService.ShareExportAsync("fatum_export.csv", csv, "Exportar Fatum (CSV)").ConfigureAwait(true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private async Task ImportJsonAsync()
    {
        _importing = true;
        _error = null;
        _successMessage = null;
        StateHasChanged();
        try
        {
            var options = new PickOptions
            {
                PickerTitle = "Seleccionar archivo JSON",
                FileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
                {
                    { DevicePlatform.WinUI, new[] { ".json" } },
                    { DevicePlatform.Android, new[] { "application/json", ".json" } },
                    { DevicePlatform.iOS, new[] { "public.json", ".json" } }
                })
            };
            var result = await FilePicker.Default.PickAsync(options).ConfigureAwait(true);
            if (result == null)
            {
                _importing = false;
                StateHasChanged();
                return;
            }
            var json = await File.ReadAllTextAsync(result.FullPath).ConfigureAwait(true);
            var count = await ExportService.ImportFromJsonAsync(json).ConfigureAwait(true);
            _successMessage = $"Importados {count} registros correctamente.";
            await LoadAsync().ConfigureAwait(true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error importando JSON");
            _error = ex.Message;
        }
        finally
        {
            _importing = false;
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            var fatumsList = (await UnitOfWork.FatumRepository.GetAllAsync().ConfigureAwait(true)).ToList();
            var anomaliasList = (await UnitOfWork.AnomaliaRepository.GetAllAsync().ConfigureAwait(true)).ToList();
            _fatums = fatumsList;
            _anomaliasByFatum = anomaliasList.GroupBy(a => a.IdFatum).ToDictionary(g => g.Key, g => g.ToList());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error cargando historial");
            _error = ex.Message;
        }
        StateHasChanged();
    }

    private void ViewOnMap(Fatum fatum)
    {
        _ = OpenInGoogleMaps(fatum.Latitude, fatum.Longitude);
    }

    private void OpenHeatmap(long fatumId)
    {
        Navigation.NavigateTo($"/heatmap/{fatumId}");
    }

    private void ViewAnomaliaOnMap(Anomalia a)
    {
        _ = OpenInGoogleMaps(a.Latitude, a.Longitude);
    }

    private async Task OpenInGoogleMaps(double lat, double lon)
    {
        var url = $"https://www.google.com/maps/search/?api=1&query={lat},{lon}";

        try
        {
            await Launcher.Default.OpenAsync(url);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "No se pudo abrir Google Maps");
        }
    }

    private async Task CopyCodeAsync(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return;

        // Fuerza a que el mensaje se “reinicie” al pulsar varias veces el botón.
        _copyMessageCts?.Cancel();
        _successMessage = null;
        StateHasChanged();

        _copyMessageCts = new System.Threading.CancellationTokenSource();
        var localCts = _copyMessageCts;

        await Clipboard.Default.SetTextAsync(value).ConfigureAwait(true);
        _successMessage = "Código copiado al portapapeles.";
        StateHasChanged();

        // Hace que el mensaje desaparezca para que, si el usuario vuelve a pulsar,
        // se muestre de nuevo claramente.
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(2000, localCts.Token).ConfigureAwait(false);
            }
            catch (OperationCanceledException)
            {
                return;
            }

            await InvokeAsync(() =>
            {
                if (_copyMessageCts == localCts)
                {
                    _successMessage = null;
                    StateHasChanged();
                }
            }).ConfigureAwait(false);
        });
    }

    

    private async Task DeleteAllAsync()
    {
        var confirm = await Application.Current!.MainPage!.DisplayAlert(
            "Eliminar todo",
            "¿Borrar todos los fatums y anomalías del historial? Esta acción no se puede deshacer.",
            "Eliminar todo",
            "Cancelar").ConfigureAwait(true);
        if (!confirm)
            return;
        _deletingAll = true;
        _error = null;
        _successMessage = null;
        StateHasChanged();
        try
        {
            await UnitOfWork.AnomaliaRepository.DeleteAllAsync().ConfigureAwait(true);
            await UnitOfWork.FatumRepository.DeleteAllAsync().ConfigureAwait(true);
            _successMessage = "Historial borrado correctamente.";
            await LoadAsync().ConfigureAwait(true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error eliminando todo el historial");
            _error = ex.Message;
        }
        finally
        {
            _deletingAll = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmAndDeleteFatumAsync(Fatum fatum)
    {
        var confirm = await Application.Current!.MainPage!.DisplayAlert(
            "Eliminar del historial",
            "¿Eliminar este Fatum (#" + fatum.Id + ") y sus anomalías del historial? Esta acción no se puede deshacer.",
            "Eliminar",
            "Cancelar").ConfigureAwait(true);
        if (!confirm)
            return;
        await DeleteFatumAsync(fatum).ConfigureAwait(true);
    }

    private async Task DeleteFatumAsync(Fatum fatum)
    {
        try
        {
            var anomalias = _anomaliasByFatum.GetValueOrDefault(fatum.Id);
            if (anomalias != null)
            {
                foreach (var a in anomalias)
                    await UnitOfWork.AnomaliaRepository.DeleteAsync(a).ConfigureAwait(true);
            }
            await UnitOfWork.FatumRepository.DeleteAsync(fatum).ConfigureAwait(true);
            await LoadAsync().ConfigureAwait(true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error eliminando Fatum");
            _error = ex.Message;
            StateHasChanged();
        }
    }
}
